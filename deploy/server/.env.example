# Copy to .env on the server and replace every placeholder.
POSTGRES_PASSWORD=replace-with-a-long-random-password
POOPSENSE_LLM_API_KEY=replace-with-your-deepseek-secret
POOPSENSE_LLM_BASE_URL=https://api.deepseek.com
POOPSENSE_LLM_MODEL=deepseek-v4-pro
POOPSENSE_PUBLIC_ORIGIN=https://your-domain.example
POOPSENSE_HTTP_PORT=80

# Persistent competition demo: fictional data only, no login.
POOPSENSE_APP_ENV=demo
POOPSENSE_BOOTSTRAP_DEMO_DEVICE=true
POOPSENSE_BOOTSTRAP_DEMO_DATA=true
