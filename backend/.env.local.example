# Copy this file to .env.local. Never commit .env.local or real keys.
# From the repository root, run .\配置模型.ps1 for hidden key input and a
# one-request connection check; only a successful check saves the new key.
POOPSENSE_APP_ENV=development
DEEPSEEK_API_KEY=
POOPSENSE_LLM_BASE_URL=https://api.deepseek.com
POOPSENSE_LLM_MODEL=deepseek-v4-pro
POOPSENSE_LLM_PROACTIVE_ENABLED=true
POOPSENSE_INLINE_WORKER_ENABLED=true

# Automatic routing is opt-in. Configure both presets with the helper, then run
# .\配置模型.ps1 enable-auto and restart the local backend.
BAICHUAN_API_KEY=
POOPSENSE_LLM_ROUTING_ENABLED=false
POOPSENSE_LLM_PROFILES={}
POOPSENSE_LLM_ROUTES={}
# Custom profile examples and task names: ../docs/model-routing.md
