# Formal runtime profile. Replace every placeholder through your deployment
# platform's encrypted environment-variable UI; never commit real secrets.
POOPSENSE_APP_ENV=production
POOPSENSE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/poopsense
POOPSENSE_BOOTSTRAP_DEMO_DEVICE=false
POOPSENSE_BOOTSTRAP_DEMO_DATA=false
POOPSENSE_AUTO_CREATE_SCHEMA=false

# Run the outbox from a scheduler/dedicated worker, not inside every API replica.
POOPSENSE_INLINE_WORKER_ENABLED=false
POOPSENSE_EXTERNAL_WORKER_ENABLED=true
# Dedicated worker processes do not expose an HTTP trigger.
POOPSENSE_HTTP_WORKER_ENABLED=false
# If the platform only supports scheduled HTTP calls, set the flag above to true
# and provide a long random Bearer token through its secret manager.
POOPSENSE_WORKER_TOKEN=

# Legacy single-provider key. Supply real values through the secret manager.
POOPSENSE_LLM_API_KEY=
POOPSENSE_LLM_BASE_URL=https://api.deepseek.com
POOPSENSE_LLM_MODEL=deepseek-v4-pro
POOPSENSE_LLM_PROACTIVE_ENABLED=true

# Automatic routing remains disabled until the required model keys and routes
# are configured. Never put key values inside POOPSENSE_LLM_PROFILES.
DEEPSEEK_API_KEY=
BAICHUAN_API_KEY=
POOPSENSE_LLM_ROUTING_ENABLED=false
POOPSENSE_LLM_PROFILES={}
POOPSENSE_LLM_ROUTES={}
# Local onboarding: .\配置模型.ps1 from the repository root. The helper does not
# update production: configure platform secrets and deploy separately.
# See ../docs/model-routing.md for profiles, routes and validation limits.

# Use the exact public frontend origin; separate multiple origins with commas.
POOPSENSE_CORS_ORIGINS=https://example.com
